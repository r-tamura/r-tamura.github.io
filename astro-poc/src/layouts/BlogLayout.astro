---
import type { MarkdownHeading } from "astro";
import { tagSlug } from "../utils/tags";

interface Props {
  title: string;
  date: Date;
  tags: string[];
  headings: MarkdownHeading[];
}

const { title, date, tags, headings } = Astro.props;
const formatted = date.toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Rの技術メモ</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Rの技術メモ" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header>
      <a href="/">Rの技術メモ</a>
    </header>
    <div class="container">
      <main>
        <article>
          <h1>{title}</h1>
          <time datetime={date.toISOString()}>{formatted}</time>
          <ul class="tags">
            {
              tags.map((t) => (
                <li>
                  <a href={`/tags/${tagSlug(t)}/`}>#{t}</a>
                </li>
              ))
            }
          </ul>
          <slot />
        </article>
      </main>
      {
        tocHeadings.length > 0 && (
          <aside class="toc" aria-label="目次">
            <p class="toc-title">目次</p>
            <ol>
              {tocHeadings.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>
    <style is:global>
      :root {
        color-scheme: light dark;
        --fg: #1a1a1a;
        --bg: #fdfdfd;
        --accent: #0b6cff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #eaeaea;
          --bg: #16181d;
          --accent: #6aa9ff;
        }
      }
      body {
        margin: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Kaku Gothic ProN", "Meiryo",
          sans-serif;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.75;
      }
      header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
      }
      header a {
        color: inherit;
        text-decoration: none;
        font-weight: 600;
      }
      .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2rem;
      }
      @media (min-width: 1000px) {
        .container {
          grid-template-columns: minmax(0, 1fr) 240px;
        }
      }
      main {
        min-width: 0;
      }
      article h1 {
        font-size: 2rem;
        line-height: 1.3;
        margin: 0 0 0.5rem;
      }
      article time {
        color: color-mix(in srgb, var(--fg) 60%, transparent);
        font-size: 0.875rem;
      }
      article h2 {
        margin-top: 2.5rem;
        padding-top: 0.5rem;
        border-top: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
      }
      ul.tags {
        list-style: none;
        padding: 0;
        margin: 0.5rem 0 2rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      ul.tags li a {
        display: inline-block;
        font-size: 0.75rem;
        padding: 0.15rem 0.6rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--fg) 8%, transparent);
        color: inherit;
        text-decoration: none;
      }
      ul.tags li a:hover {
        background: color-mix(in srgb, var(--fg) 16%, transparent);
      }
      img {
        max-width: 100%;
        height: auto;
      }
      pre {
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
      }
      code:not(pre code) {
        background: color-mix(in srgb, var(--fg) 8%, transparent);
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-size: 0.9em;
      }
      table {
        border-collapse: collapse;
        margin: 1rem 0;
      }
      th,
      td {
        border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
        padding: 0.4rem 0.75rem;
      }
      .toc {
        font-size: 0.875rem;
      }
      @media (min-width: 1000px) {
        .toc {
          position: sticky;
          top: 1rem;
          align-self: start;
          max-height: calc(100vh - 2rem);
          overflow-y: auto;
        }
      }
      .toc .toc-title {
        font-weight: 600;
        margin: 0 0 0.5rem;
        color: color-mix(in srgb, var(--fg) 70%, transparent);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.75rem;
      }
      .toc ol {
        list-style: none;
        padding: 0;
        margin: 0;
        border-left: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
      }
      .toc li {
        padding: 0.25rem 0 0.25rem 0.75rem;
      }
      .toc li.depth-3 {
        padding-left: 1.5rem;
        font-size: 0.8125rem;
      }
      .toc a {
        color: color-mix(in srgb, var(--fg) 75%, transparent);
        text-decoration: none;
      }
      .toc a:hover {
        color: var(--accent);
      }
    </style>
  </body>
</html>
