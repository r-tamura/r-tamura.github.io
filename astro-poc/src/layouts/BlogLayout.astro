---
interface Props {
  title: string;
  date: Date;
  tags: string[];
}

const { title, date, tags } = Astro.props;
const formatted = date.toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | Rの技術メモ</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <a href="/">Rの技術メモ</a>
    </header>
    <main>
      <article>
        <h1>{title}</h1>
        <time datetime={date.toISOString()}>{formatted}</time>
        <ul class="tags">
          {tags.map((t) => <li>#{t}</li>)}
        </ul>
        <slot />
      </article>
    </main>
    <style is:global>
      :root {
        color-scheme: light dark;
        --fg: #1a1a1a;
        --bg: #fdfdfd;
        --accent: #0b6cff;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #eaeaea;
          --bg: #16181d;
        }
      }
      body {
        margin: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Kaku Gothic ProN", "Meiryo",
          sans-serif;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.75;
      }
      header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
      }
      header a {
        color: inherit;
        text-decoration: none;
        font-weight: 600;
      }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }
      article h1 {
        font-size: 2rem;
        line-height: 1.3;
        margin: 0 0 0.5rem;
      }
      article time {
        color: color-mix(in srgb, var(--fg) 60%, transparent);
        font-size: 0.875rem;
      }
      ul.tags {
        list-style: none;
        padding: 0;
        margin: 0.5rem 0 2rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      ul.tags li {
        font-size: 0.75rem;
        padding: 0.15rem 0.6rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--fg) 8%, transparent);
      }
      img {
        max-width: 100%;
        height: auto;
      }
      pre {
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
      }
      code:not(pre code) {
        background: color-mix(in srgb, var(--fg) 8%, transparent);
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-size: 0.9em;
      }
      table {
        border-collapse: collapse;
        margin: 1rem 0;
      }
      th,
      td {
        border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
        padding: 0.4rem 0.75rem;
      }
    </style>
  </body>
</html>
