---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Rの技術メモ</title>
  </head>
  <body>
    <main>
      <h1>Rの技術メモ</h1>
      <p>主にWeb業界で働くエンジニアの忘備録ブログです。</p>
      <ul>
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/${post.id.replace(/\/index$/, "")}`}>{post.data.title}</a>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("ja-JP")}
              </time>
            </li>
          ))
        }
      </ul>
    </main>
    <style>
      body {
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Kaku Gothic ProN", "Meiryo",
          sans-serif;
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1.25rem;
      }
      ul {
        list-style: none;
        padding: 0;
      }
      li {
        margin: 0.5rem 0;
        display: flex;
        gap: 1rem;
        align-items: baseline;
      }
      time {
        color: gray;
        font-size: 0.875rem;
      }
    </style>
  </body>
</html>
