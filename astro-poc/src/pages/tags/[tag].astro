---
import { getCollection, type CollectionEntry } from "astro:content";
import { tagSlug } from "../../utils/tags";

export async function getStaticPaths() {
  const posts = await getCollection("articles");
  const tagToPosts = new Map<string, { name: string; posts: CollectionEntry<"articles">[] }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tagSlug(tag);
      if (!tagToPosts.has(slug)) {
        tagToPosts.set(slug, { name: tag, posts: [] });
      }
      tagToPosts.get(slug)!.posts.push(post);
    }
  }
  return [...tagToPosts.entries()].map(([slug, { name, posts }]) => ({
    params: { tag: slug },
    props: {
      name,
      posts: posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

interface Props {
  name: string;
  posts: CollectionEntry<"articles">[];
}

const { name, posts } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>#{name} | Rの技術メモ</title>
    <link rel="alternate" type="application/rss+xml" title="Rの技術メモ" href="/rss.xml" />
  </head>
  <body>
    <header><a href="/">Rの技術メモ</a></header>
    <main>
      <h1>#{name}</h1>
      <p><a href="/tags/">← タグ一覧</a></p>
      <ul>
        {
          posts.map((post) => (
            <li>
              <a href={`/articles/${post.id.replace(/\/index$/, "")}`}>{post.data.title}</a>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString("ja-JP")}
              </time>
            </li>
          ))
        }
      </ul>
    </main>
    <style>
      :root {
        color-scheme: light dark;
        --fg: #1a1a1a;
        --bg: #fdfdfd;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #eaeaea;
          --bg: #16181d;
        }
      }
      body {
        margin: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Kaku Gothic ProN", "Meiryo",
          sans-serif;
        color: var(--fg);
        background: var(--bg);
      }
      header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid color-mix(in srgb, var(--fg) 12%, transparent);
      }
      header a {
        color: inherit;
        text-decoration: none;
        font-weight: 600;
      }
      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1.25rem;
      }
      ul {
        list-style: none;
        padding: 0;
      }
      li {
        margin: 0.5rem 0;
        display: flex;
        gap: 1rem;
        align-items: baseline;
      }
      time {
        color: gray;
        font-size: 0.875rem;
      }
    </style>
  </body>
</html>
