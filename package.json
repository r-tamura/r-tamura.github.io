{
  "name": "rtam-tech-blog",
  "version": "2.0.0",
  "private": true,
  "description": "Rtam's tech blog",
  "license": "ISC",
  "author": "rtamura30 <rtamura30@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/r-tamura/r-tamura.github.io.git"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "release": "pnpm version patch -m 'release: v%s' && git push --follow-tags",
    "release:minor": "pnpm version minor -m 'release: v%s' && git push --follow-tags",
    "release:major": "pnpm version major -m 'release: v%s' && git push --follow-tags",
    "release:post": "node scripts/release-post.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.2.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@expressive-code/plugin-line-numbers": "^0.41.7",
    "astro-expressive-code": "^0.41.7",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
