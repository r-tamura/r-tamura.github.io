---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicons/fox_48x48.png" />
    <link rel="alternate" type="application/rss+xml" title="Rの技術メモ" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header>
      <a href="/">Rの技術メモ</a>
      <nav>
        <a href="/tags/">タグ</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>
    <slot />
    <style is:global>
      :root {
        color-scheme: light dark;
        --fg: #1a1a1a;
        --bg: #fdfdfd;
        --accent: #0b6cff;
        --muted: color-mix(in srgb, var(--fg) 60%, transparent);
        --border: color-mix(in srgb, var(--fg) 12%, transparent);
        --chip: color-mix(in srgb, var(--fg) 8%, transparent);
        --chip-hover: color-mix(in srgb, var(--fg) 16%, transparent);
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --fg: #eaeaea;
          --bg: #16181d;
          --accent: #6aa9ff;
        }
      }
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Kaku Gothic ProN", "Meiryo",
          sans-serif;
        color: var(--fg);
        background: var(--bg);
        line-height: 1.75;
      }
      a {
        color: var(--accent);
      }
      header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border);
      }
      header > a {
        color: inherit;
        text-decoration: none;
        font-weight: 600;
      }
      header nav {
        display: flex;
        gap: 1rem;
        font-size: 0.875rem;
      }
      header nav a {
        color: var(--muted);
        text-decoration: none;
      }
      header nav a:hover {
        color: var(--accent);
      }
      img {
        max-width: 100%;
        height: auto;
      }
    </style>
  </body>
</html>
