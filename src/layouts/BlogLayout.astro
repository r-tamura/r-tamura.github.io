---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { tagSlug } from "../utils/tags";

interface Props {
  title: string;
  date: Date;
  tags: string[];
  headings: MarkdownHeading[];
}

const { title, date, tags, headings } = Astro.props;
const formatted = date.toLocaleDateString("ja-JP", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={`${title} | Rの技術メモ`}>
  <div class="container">
    <main id="main">
      <article>
        <h1>{title}</h1>
        <time datetime={date.toISOString()}>{formatted}</time>
        <ul class="tags">
          {
            tags.map((t) => (
              <li>
                <a href={`/tags/${tagSlug(t)}/`}>#{t}</a>
              </li>
            ))
          }
        </ul>
        <slot />
      </article>
    </main>
    {
      tocHeadings.length > 0 && (
        <aside class="toc" aria-label="目次">
          <p class="toc-title">目次</p>
          <ol>
            {tocHeadings.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )
    }
  </div>
</BaseLayout>

<style is:global>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 1000px) {
    .container {
      grid-template-columns: minmax(0, 1fr) 240px;
    }
  }
  .container main {
    min-width: 0;
  }
  article h1 {
    font-size: 2rem;
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }
  article > time {
    color: var(--muted);
    font-size: 0.875rem;
  }
  article h2 {
    margin-top: 2.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }
  article ul.tags {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  article ul.tags li a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: 0.875rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--chip);
    color: inherit;
    text-decoration: none;
  }
  article ul.tags li a:hover {
    background: var(--chip-hover);
  }
  article pre {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    background: var(--code-bg) !important;
    border: 1px solid var(--border);
  }
  article pre code {
    background: transparent !important;
  }
  article code:not(pre code) {
    background: var(--code-bg);
    border: 1px solid var(--border);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }
  article table {
    border-collapse: collapse;
    margin: 1rem 0;
  }
  article th,
  article td {
    border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent);
    padding: 0.4rem 0.75rem;
  }
  .toc {
    font-size: 0.875rem;
  }
  @media (min-width: 1000px) {
    .toc {
      position: sticky;
      top: 1rem;
      align-self: start;
      max-height: calc(100vh - 2rem);
      overflow-y: auto;
    }
  }
  .toc .toc-title {
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--fg);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8125rem;
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--border);
  }
  .toc li {
    padding: 0;
  }
  .toc li.depth-3 {
    padding-left: 0.75rem;
  }
  .toc a {
    display: block;
    padding: 0.35rem 0.75rem;
    color: var(--muted);
    text-decoration: none;
    border-radius: 4px;
  }
  .toc a:hover {
    color: var(--accent);
    background: var(--chip);
  }
</style>
