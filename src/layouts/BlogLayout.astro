---
import type { MarkdownHeading } from "astro";
import BaseLayout from "./BaseLayout.astro";
import { tagSlug } from "../utils/tags";

interface Props {
  title: string;
  date: Date;
  lastModified?: Date;
  tags: string[];
  headings: MarkdownHeading[];
}

const { title, date, lastModified, tags, headings } = Astro.props;
const formatDate = (d: Date) =>
  d.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
const formatted = formatDate(date);
const formattedModified =
  lastModified && lastModified.getTime() !== date.getTime() ? formatDate(lastModified) : null;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<BaseLayout title={`${title} | Rの技術メモ`}>
  <div class="container">
    <main id="main">
      <article>
        <h1>{title}</h1>
        <p class="meta-dates">
          <time datetime={date.toISOString()}>公開: {formatted}</time>
          {
            formattedModified && (
              <time datetime={lastModified!.toISOString()}>更新: {formattedModified}</time>
            )
          }
        </p>
        <ul class="tags">
          {
            tags.map((t) => (
              <li>
                <a href={`/tags/${tagSlug(t)}/`}>#{t}</a>
              </li>
            ))
          }
        </ul>
        <slot />
      </article>
    </main>
    {
      tocHeadings.length > 0 && (
        <aside class="toc" aria-label="目次">
          <p class="toc-title">目次</p>
          <ol>
            {tocHeadings.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )
    }
  </div>
</BaseLayout>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>("[data-zoom-target]");
  for (const btn of triggers) {
    const id = btn.dataset.zoomTarget;
    if (!id) continue;
    const dialog = document.getElementById(id) as HTMLDialogElement | null;
    if (!dialog) continue;
    btn.addEventListener("click", () => dialog.showModal());
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>

<style is:global>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 1000px) {
    .container {
      grid-template-columns: minmax(0, 1fr) 240px;
    }
  }
  .container main {
    min-width: 0;
  }
  article h1 {
    font-size: 2rem;
    line-height: 1.3;
    margin: 0 0 0.5rem;
  }
  article .meta-dates {
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
  article .meta-dates time {
    font-variant-numeric: tabular-nums;
  }
  article h2 {
    margin-top: 2.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }
  article .zoom-trigger {
    display: inline-block;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
    cursor: zoom-in;
    color: inherit;
    font: inherit;
  }
  article .zoom-trigger > img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .zoom-dialog {
    width: 95vw;
    height: 95vh;
    max-width: none;
    max-height: none;
    background: transparent;
    border: none;
    padding: 0;
    margin: auto;
    overflow: visible;
  }
  .zoom-dialog > img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .zoom-dialog::backdrop {
    background: color-mix(in srgb, black 90%, transparent);
  }
  .zoom-close-form {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    margin: 0;
    z-index: 1;
  }
  .zoom-close {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.15);
    color: white;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .zoom-close:hover,
  .zoom-close:focus-visible {
    background: rgba(255, 255, 255, 0.3);
  }
  article ul.tags {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  article ul.tags li a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: 0.875rem;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--chip);
    color: inherit;
    text-decoration: none;
  }
  article ul.tags li a:hover {
    background: var(--chip-hover);
  }
  article code:not(pre code) {
    background: var(--code-bg);
    border: 1px solid var(--border);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }
  article table {
    border-collapse: collapse;
    margin: 1.25rem 0;
    width: 100%;
    font-size: 0.9375rem;
  }
  article th,
  article td {
    border: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
    padding: 0.5rem 0.85rem;
    text-align: left;
  }
  article thead th {
    background: color-mix(in srgb, var(--fg) 20%, transparent);
    color: var(--fg);
    font-weight: 700;
    text-transform: none;
    letter-spacing: 0.01em;
    border-color: color-mix(in srgb, var(--fg) 50%, transparent);
    border-bottom: 2px solid var(--fg);
  }
  article tbody tr:nth-child(even) {
    background: color-mix(in srgb, var(--fg) 5%, transparent);
  }
  article tbody td {
    border-color: color-mix(in srgb, var(--fg) 25%, transparent);
  }
  .toc {
    font-size: 0.875rem;
  }
  @media (min-width: 1000px) {
    .toc {
      position: sticky;
      top: 1rem;
      align-self: start;
      max-height: calc(100vh - 2rem);
      overflow-y: auto;
    }
  }
  .toc .toc-title {
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--fg);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8125rem;
  }
  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--border);
  }
  .toc li {
    padding: 0;
  }
  .toc li.depth-3 {
    padding-left: 0.75rem;
  }
  .toc a {
    display: block;
    padding: 0.35rem 0.75rem;
    color: var(--muted);
    text-decoration: none;
    border-radius: 4px;
  }
  .toc a:hover {
    color: var(--accent);
    background: var(--chip);
  }
</style>
