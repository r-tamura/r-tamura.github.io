---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { excerpt } from "../utils/excerpt";

const posts = (await getCollection("articles")).toSorted(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="Rの技術メモ" description="主にWeb業界で働くエンジニアの忘備録ブログです。">
  <main>
    <h1>Rの技術メモ</h1>
    <p class="lead">主にWeb業界で働くエンジニアの忘備録ブログです。</p>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a class="title" href={`/articles/${post.id.replace(/\/index$/, "")}`}>
              {post.data.title}
            </a>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("ja-JP")}
            </time>
            {post.body && <p class="excerpt">{excerpt(post.body, 140)}</p>}
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }
  .lead {
    color: var(--muted);
    margin: 0 0 2rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    margin: 0 0 1.75rem;
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    row-gap: 0.25rem;
    align-items: baseline;
  }
  .title {
    font-weight: 500;
  }
  time {
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .excerpt {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
</style>
