---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("articles")).toSorted(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="Rの技術メモ" description="主にWeb業界で働くエンジニアの忘備録ブログです。">
  <main>
    <h1>Rの技術メモ</h1>
    <p class="lead">主にWeb業界で働くエンジニアの忘備録ブログです。</p>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/articles/${post.id.replace(/\/index$/, "")}`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("ja-JP")}
            </time>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }
  .lead {
    color: var(--muted);
    margin: 0 0 2rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    margin: 0.75rem 0;
    display: flex;
    gap: 1rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  time {
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
</style>
