---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tagSlug } from "../../utils/tags";

export async function getStaticPaths() {
  const posts = await getCollection("articles");
  const tagToPosts = new Map<string, { name: string; posts: CollectionEntry<"articles">[] }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = tagSlug(tag);
      if (!tagToPosts.has(slug)) {
        tagToPosts.set(slug, { name: tag, posts: [] });
      }
      tagToPosts.get(slug)!.posts.push(post);
    }
  }
  return [...tagToPosts.entries()].map(([slug, { name, posts: tagPosts }]) => ({
    params: { tag: slug },
    props: {
      name,
      posts: tagPosts.toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

interface Props {
  name: string;
  posts: CollectionEntry<"articles">[];
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`#${name} | Rの技術メモ`}>
  <main id="main">
    <h1>#{name}</h1>
    <p><a href="/tags/">← タグ一覧</a></p>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/articles/${post.id.replace(/\/index$/, "")}`}>{post.data.title}</a>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("ja-JP")}
            </time>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
  }
  li {
    margin: 0.75rem 0;
    display: flex;
    gap: 1rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  time {
    color: var(--muted);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
</style>
