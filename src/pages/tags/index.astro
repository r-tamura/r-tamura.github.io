---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tagSlug } from "../../utils/tags";

const posts = await getCollection("articles");
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}
const tags = [...counts.entries()].toSorted(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0]),
);
---

<BaseLayout title="タグ一覧 | Rの技術メモ">
  <main>
    <h1>タグ一覧</h1>
    <ul class="tag-cloud">
      {
        tags.map(([tag, count]) => (
          <li>
            <a href={`/tags/${tagSlug(tag)}/`}>
              #{tag}
              <span class="count">({count})</span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.25rem 4rem;
  }
  h1 {
    font-size: 2rem;
    margin: 0 0 1.5rem;
  }
  ul.tag-cloud {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  ul.tag-cloud a {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--chip);
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
  }
  ul.tag-cloud a:hover {
    background: var(--chip-hover);
  }
  .count {
    opacity: 0.6;
    margin-left: 0.25rem;
  }
</style>
